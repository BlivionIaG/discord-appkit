# User token of the Discord account that owns the applications.
# Bot tokens cannot create apps or manage RPC assets.
# Set this on the private discord-portal environment. Never commit a real value.
# Never put this on the public FetchCord org.
DISCORD_USER_TOKEN=

# Optional API base. Defaults to https://discord.com/api/v10
DISCORD_API_BASE=https://discord.com/api/v10

# GitHub token used by this repo to open catalog pull requests on FetchCord.
# FETCHCORD_SYNC_TOKEN=

# GitHub token set on the FetchCord org so it can dispatch this repo.
# Not a Discord token.
# APPKIT_DISPATCH_TOKEN=
